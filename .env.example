# Copy to .env (never commit it). Load with: set -a; . ./.env; set +a
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
# Spread bet and CFD accounts have different IDs. Leave blank to use your default account.
IG_ACCOUNT_ID=
# demo (default) or live. Live also requires TDESK_ALLOW_LIVE=yes.
IG_ENV=demo
TDESK_BROKER=ig
